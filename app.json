{
  "expo": {
    "name": "Customer360 by Welspun GCC",
    "slug": "gcc360",
    "version": "0.1.0",
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D5179",
          "image": "./assets/splash-lockup.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 100,
            "backgroundColor": "#1D5179"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.gcc360.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gcc360.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "83f80a07-ab04-42f3-8e1d-e542fd17f623"
      }
    }
  }
}
