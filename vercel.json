{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/(auth|api)(/.*)?", "dest": "/api/index.py" },
    { "src": "/(profile|customers|meetings|actions|health|docs|redoc|openapi.json)(/.*)?", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
